        layer
          fill 0,0 20x20 r10 gradient(#d9d6e8ff@0,#d9d6e8ff@1)
        layer
          fill 0,0 20x20 r10 gradient(#8f6dfbff@0,#6d48e8ff@1)
        layer transform [0.5555556, 0.0, 0.0, 0.5555556, 5.0, 5.0]
          fill 0,0 18x18 r9 #ffffffff
      layer at 35,6.6
